# Copy to .env — never commit .env
AUTH_SECRET=change-me-to-a-long-random-string-32+chars
BASE_URL=http://localhost:3000
PORT=3000
DB_FILE=gym.db
ADMIN_EMAIL=owner@yourgym.com
ADMIN_PASSWORD=choose-a-strong-password
# Email (any SMTP provider), e.g. smtps://user:pass@smtp.example.com
SMTP_URL=
MAIL_FROM=Neon Motion <no-reply@yourgym.com>
# Payments (Stripe Checkout — card data never touches this server)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
# Dev only: creates demo trainers + classes
SEED_DEMO=false

# Chatbot (optional). Without a key it answers from your plans/classes using built-in rules.
# With a key it uses Claude for natural answers (key stays on the server).
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
CHAT_DAILY_LIMIT=500
